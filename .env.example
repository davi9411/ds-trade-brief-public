# =========================================================
# DS Trade Brief — variáveis de ambiente
# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ser
# commitado (está no .gitignore). Em produção os valores vêm dos
# Secrets do GitHub Actions, com os mesmos nomes.
# Os valores abaixo são PLACEHOLDERS ou vazios.
# Atenção: não coloque comentário na mesma linha do valor (o dotenv
# leria o comentário como valor); comente sempre na linha de cima.
# =========================================================

# --- Telegram (obrigatório) ---
# Token do bot, criado com @BotFather.
TELEGRAM_BOT_TOKEN=

# IDs numéricos dos destinos (canais começam com -100). O bot precisa
# ser administrador com permissão de publicar em cada um.
# Canal do brief diário:
TELEGRAM_BRIEF_CHAT_ID=
# Canal principal (resumo semanal com convite):
TELEGRAM_MAIN_CHAT_ID=
# Grupo de testes e alertas de falha:
TELEGRAM_TEST_CHAT_ID=

# --- Links exibidos nos posts ---
TELEGRAM_BRIEF_LINK=@seu_canal_de_noticias
TELEGRAM_MAIN_LINK=@seu_canal_principal
# Opcional; vazio faz o convite do semanal mostrar "(em breve)".
WHATSAPP_INVITE_LINK=

# --- Telegra.ph (páginas web dos briefs; opcional) ---
# Se vazio, uma conta é criada na primeira execução e o token é impresso.
TELEGRAPH_ACCESS_TOKEN=

# --- Finnhub (notícias de forex, tier gratuito) ---
FINNHUB_API_KEY=

# --- Google Gemini (apenas o caminho de reserva) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Ajuste fino (opcional) ---
# Quantos minutos o ciclo espera pelo texto da rotina antes de cair na reserva.
# ROUTINE_WAIT_MIN=20
